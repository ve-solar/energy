    comercio: { label:"Comercio o bodega", c:"var(--comercio)", s:"var(--comercio-soft)", icon:'<path d="M3 9h18l-1.5-5h-15z"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/>' },
