      lista:[["Cava cuarto, congeladores, exhibidora, luces y punto de venta","9 a 10 horas"],["Solo el frío: cava, congeladores y exhibidora","unas 12 horas"]],
      calc:"Consumos típicos: cava cuarto 450 W promedio, dos congeladores 150 W cada uno, exhibidora 250 W, luces 150 W, punto de venta 50 W (1,200 W en total). Se usa el 81% de la batería." },
    { id:"industrial-trifasico", cats:["industria"], name:"Industria Trifásica", price:20960, kva:"18 kVA", bat:"23.6 kWh", pan:"26 × 580 W",
      img:"industria", alt:"Techo de un edificio comercial con varias filas de paneles solares",
      desc:"Talleres mecánicos, aserraderos y plantas con motores trifásicos y maquinaria pesada.",
      eq:[["Inversor trifásico","SRNE 18 kVA","18 kVA · trifásico 220/380 V"],["Batería de litio LiFePO4","","48 V · 23.6 kWh"],["Paneles solares","","26 paneles de 580 W · 15.08 kWp"]],
      si:["Motores trifásicos","Maquinaria pesada","Compresores industriales","Iluminación del taller o la planta"], no:[],
