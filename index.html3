  };
  var BATT = '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 10v4"/><path d="m12 8.5-3 4h4l-3 4"/></svg>';

  var COMBOS = [
    { id:"hogar-esencial", cats:["hogar"], name:"Hogar Esencial", tag:"Más accesible", price:2890, kva:"3 kVA", bat:"2.56 kWh", pan:"4 × 580 W",
      img:"esencial", alt:"Inversor y batería de litio instalados en la pared de una casa",
      desc:"Respaldo para lo esencial del hogar durante los apagones: nevera, luces, ventiladores, TV, internet y punto de venta.",
      eq:[["Inversor híbrido de onda pura","Felicity Solar","3 kVA · 24 V con controlador MPPT"],["Batería de litio LiFePO4","","24 V · 100 Ah · 2.56 kWh · 6,000 ciclos"],["Paneles solares","","4 paneles monocristalinos Tier 1 de 580 W · 2.32 kWp"]],
      si:["Nevera","Iluminación LED completa","Ventiladores","Televisor e internet","Punto de venta o laptop"], no:["Lavadora","Microondas","Bomba de agua","Aire acondicionado"],
