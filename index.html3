      si:["Nevera","Iluminación LED completa","Ventiladores","Televisor e internet"], no:["Lavadora","Microondas","Bomba de agua","Aire acondicionado"],
      horas:"9 a 10 horas", horasTxt:"con nevera, luces, TV, ventiladores y router encendidos a la vez",
      lista:[["Nevera, luces, TV, ventiladores y router","9 a 10 horas"]],
      calc:"Consumos típicos: nevera 70 W, luces LED 100 W, TV y ventiladores 220 W, router 15 W (405 W en total). Se usa el 81% de la batería." },
    { id:"hogar-plus", cats:["hogar"], name:"Hogar Plus", price:4890, kva:"5 kVA", bat:"5.12 kWh", pan:"8 × 580 W",
      img:"plus", alt:"Casa con paneles solares en el techo, vista desde arriba",
      desc:"Casas familiares completas: suma lavadora, microondas y bomba de agua.",
      eq:[["Inversor híbrido de onda pura","Felicity Solar IVEM5048-LV","5 kVA · salida de 110 V"],["Batería de litio LiFePO4","","48 V · 5.12 kWh · ampliable a 10 kWh"],["Paneles solares","","8 paneles de 580 W · 4.64 kWp"]],
      si:["Nevera","Iluminación LED completa","Ventiladores","Televisor e internet","Lavadora","Microondas","Bomba de agua"], no:["Aire acondicionado"],
      horas:"7 a 8 horas", horasTxt:"con lo básico encendido más un lavado, 15 min de microondas y 1 hora de bomba",
      lista:[["Solo nevera, luces, TV, ventiladores y router","9 a 10 horas"],["Lo anterior más un lavado, 15 min de microondas y 1 h de bomba","7 a 8 horas"],["El mismo uso con la ampliación a 10 kWh","16 a 17 horas"]],
      extra:"Se puede ampliar a batería de 10 kWh para más autonomía.",
      calc:"Consumos típicos: básico 405 W; lavadora 500 W por 1 hora, microondas 1,200 W por 15 minutos, bomba de agua 370 W por 1 hora. Se usa el 81% de la batería." },
    { id:"casa-grande", cats:["hogar","comercio"], name:"Casa Grande o Bodega", price:8860, kva:"8 kVA", bat:"10 kWh", pan:"12 × 580 W",
      img:"casagrande", alt:"Técnicos instalando paneles solares en un techo de tejas",
      desc:"Viviendas con aire acondicionado o bodegas que no pueden parar.",
      eq:[["Inversor híbrido de onda pura","Felicity Solar IVGM8048","8 kVA · salida de 110/220 V"],["Batería de litio LiFePO4","","48 V · 10 kWh"],["Paneles solares","","12 paneles de 580 W · 6.96 kWp"]],
      si:["Nevera","Iluminación LED completa","Ventiladores","Televisor e internet","Lavadora","Microondas","Bomba de agua","1 o 2 aires acondicionados"], no:[],
      horas:"4 a 8 horas", horasTxt:"con luces, neveras y 1 o 2 aires acondicionados funcionando",
      lista:[["Luces y neveras, sin aire acondicionado","unas 30 horas"],["Lo anterior más 1 aire acondicionado","unas 8 horas"],["Lo anterior más 2 aires acondicionados","4 a 5 horas"]],
      calc:"Consumos típicos: luces LED 100 W, dos neveras 140 W, cada aire acondicionado 700 W. Se usa el 81% de la batería." },
    { id:"comercio", cats:["comercio"], name:"Comercio con Exhibidoras", price:9740, kva:"10 kVA", bat:"11.8 kWh", pan:"16 × 580 W",
      img:"comercio", alt:"Dos inversores y una batería de litio instalados en la pared de un local",
      desc:"Carnicerías, charcuterías y comercios medianos con neveras exhibidoras.",
      eq:[["Inversores híbridos de onda pura","2 × Felicity Solar IVEM5048","10 kVA en total · fase partida"],["Batería de litio LiFePO4","","48 V · 11.8 kWh"],["Paneles solares","","16 paneles de 580 W · 9.28 kWp"]],
      si:["Neveras exhibidoras","Aire acondicionado","Iluminación y vitrinas","Punto de venta"], no:["Cava cuarto","Congeladores","Motores trifásicos"],
      horas:"6 a 7 horas", horasTxt:"con 2 exhibidoras, aire acondicionado, vitrinas y punto de venta",
      lista:[["2 exhibidoras, aire acondicionado, vitrinas y punto de venta","6 a 7 horas"],["Lo mismo, sin el aire acondicionado","unas 13 horas"]],
      calc:"Consumos típicos: exhibidoras 250 W cada una, aire acondicionado 700 W, vitrinas 150 W, punto de venta 50 W (1,400 W en total). Se usa el 81% de la batería." },
    { id:"refrigeracion", cats:["comercio"], name:"Comercio y Refrigeración", price:12350, kva:"12 kVA", bat:"15.36 kWh", pan:"18 × 580 W",
      img:"refrigeracion", contain:true, alt:"Baterías de litio de 15.36 kWh montadas en pared",
      desc:"Abastos, panaderías y minimarkets con cava cuarto pequeña y varios congeladores.",
      eq:[["Inversor híbrido de onda pura","Shunde Energy 12 kVA","12 kVA · salida de 220 V"],["Batería de litio LiFePO4","","48 V · 15.36 kWh"],["Paneles solares","","18 paneles de 580 W · 10.44 kWp"]],
      si:["Cava cuarto pequeña","Congeladores","Neveras exhibidoras","Aire acondicionado","Iluminación y vitrinas","Punto de venta"], no:["Motores trifásicos"],
