      lista:[["Carga de 3 kW, por ejemplo un motor de 3 HP y las luces","unas 6 horas"],["Carga de 5 kW","3 a 4 horas"],["Carga de 8 kW","2 a 3 horas"]],
      calc:"Se usa el 81% de la batería de 23.6 kWh. Los motores consumen más al arrancar; la carga real se define en la inspección." },
    { id:"central-solar", cats:["industria"], name:"Central Solar", price:null,
      desc:"Proyectos de 25, 30 y 50 kW diseñados a la medida de su planta. Los equipos se definen después de la inspección." },
    { id:"solar-starlink", cats:["internet"], name:"Conectividad Total y Minería", tag:"El más pedido en zonas mineras y rurales", price:5900, kva:"5 kVA", bat:"5.12 kWh", pan:"8 × 580 W",
      img:"starlinkroof", alt:"Antena de internet satelital instalada en una azotea junto a paneles solares",
      desc:"Energía solar más internet satelital para fincas, campamentos mineros y comercios donde se cae la señal.",
      eq:[["Inversor híbrido de onda pura","Felicity Solar","5 kVA"],["Batería de litio LiFePO4","","48 V · 5.12 kWh"],["Paneles solares","","8 paneles de 580 W · 4.64 kWp"],["Antena de internet satelital","Starlink","150 a 250 Mbps · la mensualidad del servicio se paga aparte"]],
      si:["Internet satelital","Punto de venta","Cámaras de seguridad","Computadoras","Nevera y luces"], no:["Aire acondicionado","Lavadora y bomba de agua"],
      horas:"unas 12 horas", horasTxt:"de noche, con internet, punto de venta, cámaras, computadora, nevera y luces",
      lista:[["Internet, punto de venta, cámaras, computadora, nevera y luces","unas 12 horas"]],
      calc:"Consumos típicos: antena 75 W, punto de venta 50 W, cámaras 20 W, computadora 60 W, nevera 70 W, luces 60 W (335 W en total). Se usa el 81% de la batería." },
    { id:"starlink-solo", cats:["internet"], name:"Internet satelital Starlink", price:null,
      img:"starlinkkit", contain:true, alt:"Antena de internet satelital con su caja, cable, soportes y fuente",
      desc:"Solo la antena de internet satelital, para donde no llega la señal. También se puede sumar a cualquier combo de energía.",
      eq:[["Antena de internet satelital","Starlink","150 a 250 Mbps · la mensualidad del servicio se paga aparte"]] }
  ];

  function money(n) { return "$" + n.toLocaleString("en-US"); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;" }[c]; }); }
  function wa(text) { return "https://wa.me/" + WA + "?text=" + encodeURIComponent(text); }
  function comboMsg(k) {
    return "Hola, estoy interesado en el combo " + k.name + (k.price ? " (precio de referencia " + money(k.price) + " de contado)" : "") + ". ¿Me puede dar más información?";
  }

  var list = document.getElementById("list");
  var html = "";
  COMBOS.forEach(function (k, i) {
    var cat = CATS[k.cats[0]];
    var catLabel = k.cats.map(function (c) { return CATS[c].label; }).join(" · ");
    var h = '<article class="combo" id="combo-' + k.id + '" data-cats="' + k.cats.join(" ") + '" style="--c:' + cat.c + ';--soft:' + cat.s + '">';
    h += '<div class="combo-head"><span class="cat"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">' + cat.icon + '</svg>' + esc(catLabel) + '</span><span class="num">Combo ' + (i + 1) + '</span></div>';
    if (k.img && IMG[k.img]) h += '<div class="combo-photo' + (k.contain ? ' contain' : '') + '"><img src="' + IMG[k.img] + '" alt="' + esc(k.alt) + '" loading="lazy"></div>';
    h += '<div class="combo-body"><div class="title-row"><div><h3>' + esc(k.name) + '</h3>' + (k.tag ? '<span class="tag">' + esc(k.tag) + '</span>' : '') + '<p class="desc">' + esc(k.desc) + '</p></div>';
    h += '<div class="price">' + (k.price ? '<small>Precio de referencia</small><b>' + money(k.price) + '</b><small>de contado</small>' : '<small>Precio</small><b class="ask">A cotizar</b>') + '</div></div>';
    if (k.kva) h += '<div class="plate" aria-label="Datos técnicos"><div><small>Potencia</small><b>' + k.kva + '</b></div><div><small>Batería</small><b>' + k.bat + '</b></div><div><small>Paneles</small><b>' + k.pan + '</b></div></div>';
    if (k.horas) h += '<div class="backup">' + BATT + '<p>Respaldo con batería: <b>' + esc(k.horas) + '</b><br><span class="fine">' + esc(k.horasTxt) + '</span></p></div>';
    if (k.si) {
      h += '<div class="onoff"><div><h4>Mantiene encendido</h4><ul class="yes">' + k.si.map(function (x) { return "<li>" + esc(x) + "</li>"; }).join("") + '</ul></div>';
      if (k.no && k.no.length) h += '<div><h4>No incluye</h4><ul class="nop">' + k.no.map(function (x) { return "<li>" + esc(x) + "</li>"; }).join("") + '</ul></div>';
      h += '</div>';
    }
    if (k.eq) {
      h += '<details class="more"><summary>Ver equipos del combo</summary><div class="det"><div class="tbl-wrap"><table><thead><tr><th>Equipo</th><th>Marca y modelo</th><th>Especificación</th></tr></thead><tbody>';
      h += k.eq.map(function (e) { return "<tr><td>" + esc(e[0]) + "</td><td>" + (e[1] ? esc(e[1]) : "Tier 1") + "</td><td>" + esc(e[2]) + "</td></tr>"; }).join("");
      h += '</tbody></table></div>';
      if (k.extra) h += '<p class="fine"><b>Ampliación:</b> ' + esc(k.extra) + '</p>';
      if (k.lista) h += '<div><p class="mini-h">Horas de respaldo estimadas</p><ul>' + k.lista.map(function (l) { return "<li>" + esc(l[0]) + ": <b>" + esc(l[1]) + "</b></li>"; }).join("") + '</ul></div>';
      if (k.calc) h += '<p class="fine">' + esc(k.calc) + ' Es una estimación; se confirma en la inspección.</p>';
      h += '</div></details>';
    }
    h += '<div class="combo-actions"><a class="btn btn-wa" href="' + esc(wa(comboMsg(k))) + '" target="_blank" rel="noopener">' + WAICON + 'Me interesa este combo</a>';
    h += '<a class="btn btn-line" href="#agendar" data-pick="' + k.id + '">Agendar inspección</a></div>';
    h += '</div></article>';
    html += h;
  });
  list.innerHTML = html;

  // Servicios
  document.querySelectorAll("[data-svc]").forEach(function (a) {
    a.href = wa("Hola, quiero información y precio del servicio: " + a.getAttribute("data-svc") + ".");
    a.insertAdjacentHTML("afterbegin", WAICON);
  });

  // Filtros
  var pills = document.querySelectorAll(".pill");
  var cards = list.querySelectorAll(".combo");
  var count = document.getElementById("count");
  function applyFilter(f) {
    var n = 0;
    cards.forEach(function (c) {
      var ok = f === "todos" || c.getAttribute("data-cats").split(" ").indexOf(f) !== -1;
      c.hidden = !ok; if (ok) n++;
    });
    pills.forEach(function (p) { p.setAttribute("aria-pressed", p.getAttribute("data-f") === f ? "true" : "false"); });
    count.textContent = n === 1 ? "1 combo" : n + " combos";
    try { localStorage.setItem("eee-filtro", f); } catch (e) {}
  }
  pills.forEach(function (p) { p.addEventListener("click", function () { applyFilter(p.getAttribute("data-f")); }); });
  var saved = "todos";
  try { saved = localStorage.getItem("eee-filtro") || "todos"; } catch (e) {}
  applyFilter(document.querySelector('.pill[data-f="' + saved + '"]') ? saved : "todos");

  // Formulario
  var tipo = document.getElementById("f-tipo");
  var sel = document.getElementById("f-combo");
  sel.innerHTML = '<option value="">Todavía no sé, quiero asesoría</option>' + COMBOS.map(function (k) {
    return '<option value="' + k.id + '">' + esc(k.name) + (k.price ? " · " + money(k.price) : "") + '</option>';
  }).join("");

  var fecha = document.getElementById("f-fecha");
  var t = new Date();
  fecha.min = t.getFullYear() + "-" + String(t.getMonth() + 1).padStart(2, "0") + "-" + String(t.getDate()).padStart(2, "0");

  list.addEventListener("click", function (e) {
    var a = e.target.closest("[data-pick]");
    if (!a) return;
    tipo.value = "Inspección inicial";
    sel.value = a.getAttribute("data-pick");
    update();
    setTimeout(function () { document.getElementById("f-nombre").focus({ preventScroll:true }); }, 350);
  });

  var send = document.getElementById("send");
  var form = document.getElementById("book");
  function val(id) { return document.getElementById(id).value.trim(); }
  function message() {
    var k = COMBOS.filter(function (x) { return x.id === sel.value; })[0];
    var lines = ["Hola, quiero agendar: " + tipo.value + "."];
    lines.push("Nombre: " + val("f-nombre"));
    lines.push("Ciudad o sector: " + val("f-zona"));
    lines.push("Combo: " + (k ? k.name + (k.price ? " (referencia " + money(k.price) + " de contado)" : "") : "Quiero asesoría para elegir"));
    if (fecha.value) {
      var p = fecha.value.split("-");
      var d = new Date(+p[0], +p[1] - 1, +p[2]);
      lines.push("Día que prefiero: " + d.toLocaleDateString("es-VE", { weekday:"long", day:"numeric", month:"long" }));
    }
    var h = form.querySelector('input[name="horario"]:checked');
    lines.push("Horario: " + (h ? h.value : "Mañana"));
    if (val("f-nota")) lines.push("Quiero mantener encendido: " + val("f-nota"));
    return lines.join("\n");
  }
  function update() { send.href = wa(message()); }
  form.addEventListener("input", update);
  form.addEventListener("change", update);
  form.addEventListener("submit", function (e) { e.preventDefault(); });
  update();

  function check(id) {
    var el = document.getElementById("f-" + id), bad = !el.value.trim();
    el.setAttribute("aria-invalid", bad ? "true" : "false");
    document.getElementById("e-" + id).hidden = !bad;
    return !bad;
  }
  send.addEventListener("click", function (e) {
    var a = check("nombre"), b = check("zona");
    if (!(a && b)) {
      e.preventDefault();
      var first = document.querySelector('[aria-invalid="true"]');
      if (first) first.focus();
      return;
    }
    update();
  });
  ["nombre", "zona"].forEach(function (id) {
    document.getElementById("f-" + id).addEventListener("input", function () { if (this.getAttribute("aria-invalid") === "true") check(id); });
  });
})();
</script>

</body>
</html>
